            "_comment": "Dark oak: deep red-brown in fall, on top of the biome's seasonal foliage.",
            "match": ["minecraft:dark_oak_leaves"],
            "steps": {
                "early_fall": {"mix": "#6e3a1a", "amount": 0.25},
                "mid_fall": {"mix": "#6a2616", "amount": 0.55},
                "late_fall": {"mix": "#5e2a18", "amount": 0.5},
                "early_winter": {"mix": "#5a3a26", "amount": 0.3},
                "mid_winter": {"mix": "#52402e", "amount": 0.15}
            }
        },
        {
            "_comment": "Oak, jungle, acacia and mangrove read the biome's foliage colour, so they follow the biome palette (jungles and mangrove swamps stay green; savannas yellow in mid summer).",
            "match": ["minecraft:oak_leaves", "minecraft:jungle_leaves", "minecraft:acacia_leaves", "minecraft:mangrove_leaves"],
            "follow": "foliage"
        },
        {
            "_comment": "Untinted leaves keep their own textures: cherry, azalea, pale oak and the Dappled Forest's poplars.",
            "match": ["minecraft:cherry_leaves", "minecraft:azalea_leaves", "minecraft:flowering_azalea_leaves", "minecraft:pale_oak_leaves", "minecraft:orange_poplar_leaves", "minecraft:yellow_poplar_leaves", "minecraft:red_poplar_leaves"],
            "keep": true
        },
        {
            "_comment": "Any other leaves: tinted ones follow the biome foliage palette, untinted ones stay as they are.",
            "match": ["#minecraft:leaves"],
            "follow": "foliage"
        }
    ]
}
