    "leaves": [
        {
            "_comment": "Birch: clear yellow in fall, from its own fixed tint.",
            "match": ["minecraft:birch_leaves"],
            "steps": {
                "early_spring": {"mix": "#8fcf5a", "amount": 0.25},
                "mid_spring": {"mix": "#8acb5a", "amount": 0.15},
